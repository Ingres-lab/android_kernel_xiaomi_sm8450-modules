# ingres (waipio): the Neo 6.6 audio-kernel (all Xiaomi commits), built for 6.12.
# Sources: aosp/kernel/xiaomi/sm8450-modules/qcom/opensource/audio-kernel.
package(
    default_visibility = [
        "//visibility:public",
    ],
)

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

filegroup(
    name = "audio_dt_bindings",
    srcs = glob(["include/bindings/**"]),
)

ddk_headers(
    name = "audio_common_headers",
    hdrs = glob([
        "include/asoc/*.h",
        "include/bindings/*.h",
        "include/dsp/*.h",
        "include/ipc/*.h",
        "include/soc/*.h"
    ]),
    includes = ["include"]
)
ddk_headers(
    name = "audio_uapi_headers",
    hdrs = glob([
        "include/uapi/audio/**/*.h"
    ]),
    includes = ["include/uapi/audio"]
)
ddk_headers(
    name = "audio_src_headers",
    hdrs = glob([
        "asoc/**/*.h",
        "asoc/codecs/cs35l41/cs35l41-cal.c",
        "dsp/**/*.h",
        "ipc/**/*.h",
        "soc/**/*.h"
    ])
)
ddk_headers(
    name = "audio_configs",
    hdrs = glob([
        "config/*.h"
    ]),
    includes = ["config"]
)
ddk_headers(
    name = "audio_headers",
    hdrs = [":audio_common_headers",  ":audio_uapi_headers", ":audio_src_headers", ":audio_configs"]
)



load(":build/waipio.bzl", "define_waipio")

define_waipio()
